{
  "name": "@staticcanvas/asciiam",
  "version": "0.26.0",
  "description": "A dependency-free, efficient HTML5 Canvas and WebGL2 animation engine for animated ASCII backgrounds, real-time image/GIF sampling, 3D GLTF models, and morphing sequence transitions",
  "license": "MIT",
  "type": "module",
  "main": "dist/asciiam.cjs",
  "module": "dist/asciiam.mjs",
  "types": "src/asciiam.d.ts",
  "jsdelivr": "dist/asciiam.min.js",
  "unpkg": "dist/asciiam.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/staticcanvas/asciiam.git"
  },
  "homepage": "https://gitlab.com/staticcanvas/asciiam#readme",
  "exports": {
    ".": {
      "types": "./src/asciiam.d.ts",
      "import": "./dist/asciiam.mjs",
      "require": "./dist/asciiam.cjs",
      "default": "./dist/asciiam.mjs"
    }
  },
  "extras": {
    "compliedBy": {
      "rollup": "v4",
      "vite": "v7.2.4",
      "eslint": "^9.17.0",
      "node": ">=18.0.0"
    }
  },
  "author": {
    "name": "Garvey K. Snow",
    "email": "sgkens@gmail.com",
    "url": "https://gitlab.com/staticcanvas/asciiam",
    "github": "https://github.com/staticcanvas/asciiam",
    "gitlab": "https://gitlab.com/staticcanvas/asciiam"
  },
  "keywords": [
    "ascii",
    "animation",
    "canvas",
    "ascii-art",
    "image-to-ascii",
    "static-site",
    "javascript",
    "es6",
    "visualization"
  ],
  "scripts": {
    "prepare:bg": "node scripts/generate-asset-manifest.js",
    "prepare:docs": "node scripts/generate-docs-data.js",
    "predev": "npm run prepare:bg",
    "prebuild": "npm run prepare:bg",
    "dev": "vite build --watch",
    "build": "vite build",
    "docs:build": "npm run build && npm run prepare:docs && node scripts/build-docs.js",
    "docs:serve": "npm run build && npm run prepare:docs && hugo server --source docs --buildDrafts --disableFastRender",
    "site:build": "npm run docs:build",
    "cache:purge": "node scripts/purge-cache.js",
    "site:serve": "npm run cache:purge && npm run site:build && http-server public -p 8085 -c-1",
    "benchmark": "node scripts/benchmark-renderer.js",
    "benchmark:stats": "node scripts/benchmark-stats.js",
    "benchmark:mesh": "node scripts/benchmark-mesh.js",
    "benchmark:model": "node scripts/benchmark-model-loading.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:browser": "npm run docs:build && node scripts/test-webutil-browser.js",
    "test:browser:install": "playwright-core install chromium firefox webkit",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "update:npm": "npm install -g npm@latest",
    "serve:example": "npm run cache:purge && npm run docs:build && http-server public -p 8001 -c-1",
    "publish:npm": "npm run lint:fix && npm run build && cd dist/asciiam && echo //registry.npmjs.org/:_authToken=${NPM_API_KEY} > .npmrc && npm publish --access public",
    "publish:jsr": "npm run lint:fix && npm run build && cd dist/asciiam && npx jsr publish --allow-dirty"
  },
  "files": [
    "dist",
    "src",
    "branding",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@staticcanvas/lume": "^0.36.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^8.8.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3",
    "playwright-core": "^1.62.1",
    "prettier": "^2.8.8",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^7.2.4",
    "vite-plugin-banner": "^0.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie < 11"
  ],
  "jest": {
    "modulePathIgnorePatterns": [
      "/dist/"
    ],
    "testPathIgnorePatterns": [
      "/dist/"
    ]
  }
}
