{
  "name": "@staticcanvas/asciiam",
  "version": "1.0.0",
  "description": "A dependency-free canvas engine for animated ASCII backgrounds and image-to-ASCII effects",
  "license": "MIT",
  "type": "module",
  "main": "dist/asciiam.js",
  "module": "dist/asciiam.esm.js",
  "types": "src/asciiam.d.ts",
  "jsdelivr": "dist/asciiam.min.js",
  "unpkg": "dist/asciiam.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/staticcanvas/asciiam.git"
  },
  "homepage": "https://gitlab.com/staticcanvas/asciiam#readme",
  "exports": {
    ".": {
      "types": "./src/asciiam.d.ts",
      "import": "./dist/asciiam.esm.js",
      "require": "./dist/asciiam.js",
      "default": "./dist/asciiam.esm.js"
    }
  },
  "extras": {
    "compliedBy": {
      "rollup": "v4",
      "vite": "v7.2.4",
      "eslint": "^9.17.0",
      "node": ">=18.0.0"
    }
  },
  "author": {
    "name": "Garvey K. Snow",
    "email": "sgkens@gmail.com",
    "url": "https://gitlab.com/staticcanvas/asciiam",
    "github": "https://github.com/staticcanvas/asciiam",
    "gitlab": "https://gitlab.com/staticcanvas/asciiam"
  },
  "keywords": [
    "ascii",
    "animation",
    "canvas",
    "ascii-art",
    "image-to-ascii",
    "static-site",
    "javascript",
    "es6",
    "visualization"
  ],
  "scripts": {
    "prepare:bg": "node scripts/generate-bg-manifest.js",
    "predev": "npm run prepare:bg",
    "prebuild": "npm run prepare:bg",
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "update:npm": "npm install -g npm@latest",
    "serve:example": "npm run build && http-server public -p 8085",
    "publish:npm": "npm run lint:fix && npm run build && cd dist/asciiam && echo //registry.npmjs.org/:_authToken=${NPM_API_KEY} > .npmrc && npm publish --access public",
    "publish:jsr": "npm run lint:fix && npm run build && cd dist/asciiam && npx jsr publish --allow-dirty"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "eslint": "^9.17.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup-plugin-copy": "^3.5.0",
    "@rollup/plugin-terser": "^0.4.4",
    "vite": "^7.2.4",
    "vite-plugin-banner": "^0.7.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie < 11"
  ],
  "jest": {
    "modulePathIgnorePatterns": [
      "/dist/"
    ],
    "testPathIgnorePatterns": [
      "/dist/"
    ]
  }
}
